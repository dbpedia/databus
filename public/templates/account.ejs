<%- include('header') -%>

  <script src="/min/d3.min.js"></script>
  <div ng-controller="AccountPageController">
    <databus-alert></databus-alert>
    <style>
      .profile-picture {
        background-color: white;
        margin-bottom: 1em;
        display: flex;
      }

      .profile-picture img {
        width: 500px;
        height: auto;
      }

      .profile-banner {
        display: flex;
        width: 100%;
        align-items: flex-end;
        padding: 1em 0em;
      }

      .profile-banner .title {
        color: white;
      }
    </style>

    <!-- Banner Section-->
    <section class="hero is-medium-small databus-banner is-consumer">
      <div class="hero-body">
        <div class="container has-text-left">
          <div style="display: flex; align-items: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24">
              <path class="is-white" fill="#fff"
                d="M19 7.001c0 3.865-3.134 7-7 7s-7-3.135-7-7c0-3.867 3.134-7.001 7-7.001s7 3.134 7 7.001zm-1.598 7.18c-1.506 1.137-3.374 1.82-5.402 1.82-2.03 0-3.899-.685-5.407-1.822-4.072 1.793-6.593 7.376-6.593 9.821h24c0-2.423-2.6-8.006-6.598-9.819z" />
            </svg>
            <div style="margin-left: 24px;">
              <h1 class="title is-2 has-text-left is-marginless">{{ account.label }}</h1>
              <uri-breadcrumbs class="header-breadcrumbs" uri="account.uri"></uri-breadcrumbs>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!--Navbar -->
    <div class="collection-editor-header" >
      <div class="container">
        <!--Tabs-->
        <div class="collection-editor-tabs">
          <div class="collection-editor-tab" ng-class="{ 'is-active' : tabNavigation.activeTab == 0 }"
            ng-click="tabNavigation.navigateTo('home');">
            <div class="section-label">Home</div>
          </div>
          <div ng-if="false" class="collection-editor-tab" ng-class="{ 'is-active' : tabNavigation.activeTab == 1 }"
            ng-click="tabNavigation.navigateTo('groups');">
            <div class="section-label">Groups</div>
          </div>
          <div class="collection-editor-tab" ng-class="{ 'is-active' : tabNavigation.activeTab == 2 }"
            ng-click="tabNavigation.navigateTo('collections');">
            <div class="section-label">Collections</div>
          </div>
          <div ng-if="account.isOwn" class="collection-editor-tab"
            ng-class="{ 'is-active' : tabNavigation.activeTab == 3 }" ng-click="tabNavigation.navigateTo('settings')">
            <div class="section-label">
              <databus-icon style="margin-right:12px;" shape="'settings'" size="24">
              </databus-icon>Settings
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      .dashboard-card {
        margin-bottom: 1em;
        padding: 1em 0em;
      }

      .dashboard-card-title {
        margin-bottom: 0.75em;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .hierarchy-card-element {
        display: flex;
        align-items: center;
      }

      .hierarchy-card-cell {
        min-width: 500px;
      }

      .upload-info li {
        padding: 1em;
      }

      .upload-info h1 {
        margin-top: 0.5em;
        margin-bottom: 0;
      }

      .columns .column {
        padding: 0.5em;
      }

      .ce-collection-list-header {
        display: flex;
        margin-bottom: 1em;
      }

      .ce-collection-list-header .search-input {
        max-width: 800px;
        flex: 1;
        margin-right: .5em;
      }

      .ce-collection-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1em;
        margin-bottom: 1em;
        border-radius: 8px;
        border: 1px solid #dbdbdb;
      }

      .ce-collection-list-item:not(:last-child) {
        border-bottom: 1px solid #dbdbdb;
      }

      .ce-flex-filler {
        flex: 1;
      }

      .ce-collection-list-item h1 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        margin-right: .5em;
      }

      .ce-collection-list-item h1 a {
        color: inherit;
      }

      .ce-collection-list-item .ce-tool-icons {
        display: flex;
        margin-right: 2em;
      }

      .ce-collection-list-item-header {
        align-items: center;
        margin-bottom: 1em;
        display: flex;
      }

      .ce-collection-list-item-body ul {
        display: flex;
      }

      .ce-collection-list-item-body p {
        margin-bottom: 0.5em;
      }

      .ce-collection-list-item-body li {
        margin-right: 2em;
      }

      .ce-placeholder-text {
        color: rgb(170, 170, 170);
      }

      .account-page-tab {
        min-height: 800px;
      }

      .account-resource-tree .resource-row {
        display: flex;
        align-items: center;
        border: 1px solid #dbdbdb;
        border-radius: 8px;
        padding: 0.75em;
        margin-bottom: 0.45em;
        background-color: white;
      }

      .account-resource-tree .resource-children {
        margin-left: 1.75em;
      }

      .account-resource-tree .resource-text {
        flex: 1;
        min-width: 0;
      }

      .account-resource-tree .resource-label {
        color: hsl(0, 0%, 21%);
        font-size: 1em;
        font-weight: 600;
        line-height: 1.125;
        margin-bottom: 2px;
      }

      .account-resource-tree .resource-segment {
        display: block;
        font-size: 0.9em;
        font-weight: 400;
        line-height: 1.25;
      }

      .account-resource-tree type-tag {
        margin-right: 12px;
      }

      .account-resource-tree type-tag svg {
        width: 26px;
        height: 26px;
      }

      .account-resource-tree .resource-version {
        margin-left: auto;
        padding: 0.3em 0.75em;
        border-radius: 999px;
        background-color: #f0f0f0;
        color: #6b6b6b;
        font-size: 0.8em;
        font-weight: 600;
        white-space: nowrap;
      }

      .account-resource-tree .resource-version:hover {
        background-color: #e6e6e6;
        color: #4a4a4a;
      }

      .settings-entity {
        border: 1px solid #dbdbdb;
        padding: 0.5em;
        padding-left: 1em;
        display: flex;
        margin-bottom: 1em;
        align-items: center;
        min-height: 54px;
        border-radius: 8px;
        background-color: #fafbfc;
      }
    </style>

    <div class="section" style="min-height: 500px;" >
      <!-- DATA -->
      <div ng-if="tabNavigation.activeTab == 0" class="container account-page-tab">
        <div class="columns" style="margin: 0">
          <div class="column is-3" style="padding: 0; padding-right: 3em; ">
            <div class="profile-picture" style="margin-bottom: 2em;">
              <img ng-src="{{ getImageUrl() }}"></img>
            </div>
            <div ng-if="account.about" class="dashboard-card">
              <div class="dashboard-card-title">About</div>
              <p>{{ account.about }}</p>
            </div>
            <account-history account-name="account.accountName"></account-history>
          </div>
          <div class="column" style="padding: 0">
            <div class="control has-icons-left" style="margin-bottom: 1em;">
              <input class="input" type="text" ng-model="homeSearch.input" ng-change="filterHome()"
                placeholder="Search groups and artifacts...">
              <span class="icon is-left">
                <i class="fas fa-search"></i>
              </span>
            </div>
            <div ng-if="publishedData.isLoading">
              <div class="databus-no-content placeholder-medium">
                <div class="lds-ellipsis">
                  <div></div>
                  <div></div>
                  <div></div>
                  <div></div>
                </div>
              </div>
            </div>
            <div class="account-resource-tree" ng-if="!publishedData.isLoading">
              <div ng-repeat="node in homeTree track by node.group.uri">
                <div class="resource-row">
                  <type-tag width="40" height="40" type="'Group'"></type-tag>
                  <div class="resource-text">
                    <div class="resource-label search-result" ng-bind-html="node.labelHtml"></div>
                    <a class="resource-segment search-result" ng-href="{{ node.group.uri }}" ng-bind-html="node.segmentHtml"></a>
                  </div>
                </div>
                <div class="resource-children" ng-if="node.artifacts.length > 0">
                  <div class="resource-row" ng-repeat="artifact in node.artifacts track by artifact.uri">
                    <type-tag width="40" height="40" type="'Artifact'"></type-tag>
                    <div class="resource-text">
                      <div class="resource-label search-result" ng-bind-html="artifact.labelHtml"></div>
                      <a class="resource-segment search-result" ng-href="{{ artifact.uri }}" ng-bind-html="artifact.segmentHtml"></a>
                    </div>
                    <a class="resource-version" ng-if="artifact.latestVersionUri" ng-href="{{ artifact.latestVersionUri }}">To latest version</a>
                  </div>
                </div>
              </div>
              <div class="ce-placeholder-text" ng-if="homeTree.length == 0">No resources found.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- GROUPS -->
      <div class="container account-page-tab" ng-if="tabNavigation.activeTab == 1">
        <div class="ce-collection-list-header">
          <div class="search-input control has-icons-left">
            <input class="input" type="text" ng-model="groupSearch.input" ng-change="filterGroups()"
              placeholder="Search groups...">
            <span class="icon is-left">
              <i class="fas fa-search"></i>
            </span>
          </div>
          <div class="ce-flex-filler"></div>
          <div ng-if="account.isOwn" class="button is-collection" ng-click="toggleNewGroupForm()">Create New</div>
        </div>

        <div ng-if="groupForm.open" class="ce-collection-list-item" style="display: block;">
          <h1 style="margin-bottom: 0.75em;">New Group</h1>
          <div class="field">
            <label class="label">Name</label>
            <input class="input" type="text" ng-model="groupForm.name" placeholder="group-name">
            <p class="help is-danger" ng-if="groupForm.error">{{ groupForm.error }}</p>
          </div>
          <div class="field">
            <label class="label">Title</label>
            <input class="input" type="text" ng-model="groupForm.title">
          </div>
          <div class="field">
            <label class="label">Abstract</label>
            <textarea class="input" style="height: 80px;" ng-model="groupForm.abstract"></textarea>
          </div>
          <div class="field">
            <label class="label">Description</label>
            <textarea class="input" style="height: 80px;" ng-model="groupForm.description"></textarea>
          </div>
          <div class="field is-grouped">
            <div class="control">
              <button class="button is-collection" ng-click="submitNewGroup()" ng-disabled="groupForm.saving">Create</button>
            </div>
            <div class="control">
              <button class="button" ng-click="groupForm.open = false">Cancel</button>
            </div>
          </div>
        </div>

        <div ng-if="publishedData.isLoading">
          <div class="databus-no-content placeholder-medium">
            <div class="lds-ellipsis">
              <div></div>
              <div></div>
              <div></div>
              <div></div>
            </div>
          </div>
        </div>

        <div ng-if="!publishedData.isLoading">
          <div ng-repeat="item in groupSearch.results" style="margin-bottom: 1em;">
            <entity-card style="flex: 1;" type="'Group'" uri="item.group.uri" label="item.titleHtml"
              desc="item.abstractHtml">
            </entity-card>
          </div>
          <div class="ce-placeholder-text" ng-if="groupSearch.results.length == 0">
            No groups found.
          </div>
        </div>
      </div>

      <!-- COLLECTIONS -->
      <div class="container account-page-tab" ng-if="tabNavigation.activeTab == 2">
        <div class="ce-collection-list-header">
          <div class="search-input control has-icons-left">
            <input class="input" type="text" ng-model="collectionSearch.input" placeholder="Search collections...">
            <span class="icon is-left">
              <i class="fas fa-search"></i>
            </span>
          </div>
          <div class="control">
            <div class="dropdown" ng-class="{ 'is-active' : collectionSearch.sortVisible }">
              <div class="dropdown-trigger">
                <a class="button" aria-haspopup="true" aria-controls="dropdown-menu"
                  ng-click="collectionSearch.sortVisible=true">
                  <span>Sort By</span>
                  <span class="icon is-small">
                    <i class="fas fa-angle-down" aria-hidden="true"></i>
                  </span>
                </a>
              </div>
              <div class="dropdown-menu" id="dropdown-menu" role="menu"
                style="left: initial; right: 0; padding-top: 8px;">
                <div class="click-outside-mask" ng-if="collectionSearch.sortVisible"
                  ng-click=" collectionSearch.sortVisible=false"></div>
                <div class="dropdown-content">

                  <div class="dropdown-item" style="display: flex;"
                    ng-repeat="property in collectionSearch.sortProperties"
                    ng-click="collectionSearch.toggleSort(property.key)">
                    <div style="flex:1;">{{ property.label }}</div>
                    <div>
                      <databus-icon ng-if="collectionSearch.sortProperty==property.key && !collectionSearch.sortReverse"
                        shape="'sort-asc'" size="20">
                      </databus-icon>
                      <databus-icon ng-if="collectionSearch.sortProperty==property.key && collectionSearch.sortReverse"
                        shape="'sort-desc'" size="20">
                      </databus-icon>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="ce-flex-filler"></div>
          <div ng-if="account.isOwn" class="button is-collection" ng-click="createNewCollection()">Create New
          </div>
        </div>

        <div ng-if="account.isOwn">
          <div class="ce-collection-list">
            <div class="ce-collection-list-item"
              ng-repeat="collection in collectionList | collectionfilter:collectionSearch.input | orderBy:collectionSearch.sortProperty:collectionSearch.sortReverse">
              <div>
                <div class="ce-collection-list-item-header">
                  <type-tag width="48" height="48" style="margin-right:12px" type="'Collection'"
                    ng-class="{ 'grey-out' : collection.isDraft || !collection.isPublished }">
                  </type-tag>
                  <div>
                    <h1>{{ collection.title }}</h1>
                    <div class="ce-placeholder-text" ng-if="!collection.uri">Local draft</div>
                    <uri-breadcrumbs ng-if="collection.uri" uri="collection.uri"></uri-breadcrumbs>
                  </div>
                </div>
                <div class="ce-collection-list-item-body">
                  <p class="ce-placeholder-text" ng-if="!collection.abstract">No abstract available</p>
                  <p>{{ collection.abstract }}</p>
                  <ul>
                    <li>
                      <collection-status is-published="collection.isPublished" is-draft="collection.isDraft"
                        has-local-changes="collection.hasLocalChanges" class="ng-isolate-scope">
                      </collection-status>
                    </li>
                    <li>
                      <div ng-if="collection.issued" style="color: #aaa;">{{
                        formatCollectionDateFromNow(collection.issued) }}</div>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="ce-tool-icons">
                <databus-icon ng-if="!collection.isDraft" style="margin-right: 3em;" shape="'clipboard'" size="24"
                  is-clickable="true" on-click="utils.copyToClipboard(collection.uri)"></databus-icon>
                <databus-icon style="margin-right: 3em;" shape="'copy'" size="24" is-clickable="true"
                  on-click="createCopy(collection)"></databus-icon>
                <databus-icon style="margin-right:16px;" shape="'edit'" size="24" is-clickable="true"
                  on-click="onEditCollectionClicked(collection)"></databus-icon>
              </div>
            </div>
          </div>
        </div>
        <div ng-if="!account.isOwn">

          <div
            ng-repeat="collection in collectionsData.collections  | collectionfilter:collectionSearch.input | orderBy:collectionSearch.sortProperty:collectionSearch.sortReverse">
            <div style="margin-bottom: 1em;">
              <entity-card label="collection.title" uri="collection.uri" type="'Collection'" desc="collection.abstract"
                date="formatCollectionDateFromNow(collection.issued)">
              </entity-card>
            </div>
          </div>
        </div>
      </div>


      <div class="container" ng-if="tabNavigation.activeTab == 3">
        <%- include('profile') -%>
      </div>


      </section>
    </div>
    <%- include('footer') -%>
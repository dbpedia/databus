PREFIX databus: <https://dataid.dbpedia.org/databus#>

# UNION, not OPTIONAL: group triples are repeated in every version graph,
# so a join multiplies them with all group members (millions of rows).
CONSTRUCT {
  ?group ?p ?o .
  ?group databus:hasArtifact ?artifact .
}
WHERE {
  VALUES ?group { <%RESOURCE_URI%> }
  {
    GRAPH ?gGroup {
      ?group ?p ?o .
    }
  }
  UNION
  {
    GRAPH ?gArtifact {
      ?artifact databus:group ?group ;
        a databus:Artifact .
    }
  }
}
